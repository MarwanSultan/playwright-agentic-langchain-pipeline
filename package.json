{
  "name": "playwright-agentic-devsecops",
  "version": "1.0.0",
  "description": "Production-oriented Playwright test automation framework for public VA.gov behavior.",
  "main": "index.js",
  "scripts": {
    "chat": "tsx chatbot/cli.ts",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:network": "playwright test tests/network",
    "test:unit": "vitest run",
    "test:agent": "vitest run unit/investigator.spec.ts",
    "agent:config": "tsx agentic/investigator/cli.ts",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:local": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm audit --audit-level=high && HEADLESS=true npm test",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.0",
    "@types/vscode": "^1.137.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "dotenv": "^17.4.2",
    "langchain": "^1.5.11",
    "tar": "^7.5.21",
    "zod": "^4.5.4"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "playwright-devsecops.agent",
        "name": "devsec",
        "description": "Playwright DevSecOps QA Assistant",
        "isSticky": true
      }
    ]
  }
}
