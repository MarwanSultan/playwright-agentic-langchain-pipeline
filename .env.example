# Test environment
BASE_URL=https://www.va.gov
API_BASE_URL=https://www.va.gov
IRS_BASE_URL=https://www.irs.gov
ENVIRONMENT=local
CI=false
HEADLESS=false
WORKERS=2
RETRIES=0
TIMEOUT=30000

# Playwright sharding
# SHARD_INDEX=1
# SHARD_TOTAL=2

# OpenAI / Agentic AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional local LLM configuration
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://127.0.0.1:11434

# Optional vLLM configuration
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_API_KEY=local-vllm


# Playwright MCP
# PLAYWRIGHT_MCP_COMMAND=npx
# PLAYWRIGHT_MCP_ARGS=@playwright/mcp@latest

# Agent safety boundaries
AGENT_ALLOWED_DOMAINS=www.va.gov,api.va.gov,localhost,127.0.0.1
AGENT_MAX_EVIDENCE_BYTES=1000000
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_MS=30000